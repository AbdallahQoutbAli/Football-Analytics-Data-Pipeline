# ========================================
# Football Analytics Pipeline - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ========================================

# ----------------------------------------
# Snowflake Configuration
# ----------------------------------------
SNOWFLAKE_ACCOUNT=your_account.snowflakecomputing.com
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=FOOTBALL_ANALYTICS
SNOWFLAKE_SCHEMA=MANUTD
SNOWFLAKE_WAREHOUSE=ANALYTICS_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# ----------------------------------------
# Azure Configuration
# ----------------------------------------
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_CONTAINER=statsbomb-raw
AZURE_STORAGE_SAS_TOKEN=your_sas_token

# ----------------------------------------
# Databricks Configuration
# ----------------------------------------
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=your_token
DATABRICKS_CLUSTER_ID=your_cluster_id

# ----------------------------------------
# Data Paths
# ----------------------------------------
DATA_PATH=dbfs:/statsbomb-data
OUTPUT_PATH=dbfs:/processed-data

# ----------------------------------------
# Optional: Power BI Configuration
# ----------------------------------------
# POWERBI_WORKSPACE_ID=your_workspace_id
# POWERBI_DATASET_ID=your_dataset_id
